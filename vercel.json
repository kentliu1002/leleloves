{
  "regions": ["hkg1"],
  "functions": {
    "app/api/**": {
      "regions": ["hkg1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron/score",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/parent",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
